# gemstone 发布配置模板（GitHub）
#
# 用法：
#   cp scripts/release.env.example scripts/release.env
#   vim scripts/release.env
#
# release.env 已在 .gitignore 中，不要提交。

# ── 仓库 ─────────────────────────────────────────────────
# core 仓库（AAR 发到它的 GitHub Packages）
CORE_REPO="your-org/core"

# iOS SPM 分发仓库（xcframework.zip 挂到它的 Release，Package.swift 也在这）
SWIFT_REPO="your-org/gemstone-swift"

# gemstone-swift 的 clone 地址（SSH 优先，避免 https 反复要凭据）
SWIFT_REPO_GIT="git@github.com:your-org/gemstone-swift.git"

# ── Maven 坐标 ───────────────────────────────────────────
MAVEN_GROUP="com.gemwallet.gemstone"
MAVEN_ARTIFACT="gemstone"

# ── 可选 ─────────────────────────────────────────────────
# 验收时用的模拟器机型
SIMULATOR_NAME="iPhone 17"

# ── Token ────────────────────────────────────────────────
# 🔴 不要写在这里，用环境变量注入。
#
# 需要两个 scope：
#   write:packages   —— 发 AAR 到 GitHub Packages
#   repo             —— 推文件 / 建 Release 到 gemstone-swift
#
#   export GH_TOKEN="ghp_xxxxxxxxxxxx"
#
# ⚠️ GitHub Packages 的 Maven registry 历史上只认 classic PAT，
#    fine-grained token 支持有限。建议先用 classic PAT，
#    如果你们组织策略要求 fine-grained，先用 preflight.sh 验证能否通过。
#
# gh CLI 会优先读 GH_TOKEN，其次读 `gh auth login` 存的凭据。
# Gradle 发 Maven 需要 GITHUB_ACTOR（用户名）+ GH_TOKEN，
# preflight.sh 会检查这两个。
